# Configuration template only. Copy to .env.local (web) or .env (API / agent).
# Generate your own secrets. AUTH_SECRET and SAMP_AGENT_KEY must be set before use.
# Optional mail and Discord integrations are unconfigured.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
CDN_DIR=./cdn
DATABASE_URL=mysql://openrp:CHANGE_ME@127.0.0.1:3306/omprp
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_UCP_ROLE_ID=
RCON_HOST=127.0.0.1
RCON_PORT=7777
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
SAMP_AGENT_KEY=
SAMP_AGENT_URL=http://127.0.0.1:7001
SAMP_MAX_PLAYERS=50
SAMP_QUERY_HOST=127.0.0.1
SMTP_FROM=OpenRP Framework <noreply@example.com>
SMTP_HOST=127.0.0.1
SMTP_PASS=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=

# Enable only after configuring Discord OAuth, bot, guild and role settings.
DISCORD_ENABLED=false

# Also enable FEATURE_CUSTOM_SKINS in the gamemode and restart it.
CUSTOM_SKINS_ENABLED=false


# Standalone npm start bind address; use a reverse proxy for public HTTPS.
WEB_BIND=127.0.0.1

# Standalone or container web listening port.
PORT=3000
