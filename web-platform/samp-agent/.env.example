# Configuration template only. Copy to .env.local (web) or .env (API / agent).
# Generate your own secrets. AUTH_SECRET and SAMP_AGENT_KEY must be set before use.
# Optional mail, Discord and voice integrations are unconfigured.
AGENT_PORT=7001
SAMP_AGENT_KEY=
SAMP_BIN=./omp-server
SAMP_DIR=/path/to/openrp-framework
SAMP_HOST=127.0.0.1
SAMP_PORT=7777
SAMP_RCON_PASSWORD=
# Windows: SAMP_DIR=F:/path/to/openrp-framework and SAMP_BIN=./omp-server.exe

# Keep loopback for standalone use; use 0.0.0.0 only on a private container network.
AGENT_BIND=127.0.0.1
