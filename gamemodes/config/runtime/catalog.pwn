// Exact integer percentages avoid overflowing amount * percent.
stock Runtime_MoneyPercent(amount,percent) { if(amount<=0 || percent<=0) return 0; if(amount/100>2000000000/percent) return 2000000000; return min(2000000000,(amount/100)*percent+((amount%100)*percent)/100); }
// Constant-time reads use the last validated, applied snapshot; never query SQL.
stock Runtime_Int(key) { return RuntimeIntegers[key]; }
stock Float:Runtime_Float(key) { return RuntimeNumbers[key]; }
stock bool:Runtime_AtLocation(playerid, index, Float:range = -1.0) { if (index < 0 || index >= RuntimeLocationCount || !RuntimeLocations[index][RLOC_ENABLED]) return false; if (GetPlayerInterior(playerid) != RuntimeLocations[index][RLOC_INTERIOR] || GetPlayerVirtualWorld(playerid) != RuntimeLocations[index][RLOC_WORLD]) return false; return IsPlayerInRangeOfPoint(playerid, range < 0.0 ? RuntimeLocations[index][RLOC_RADIUS] : range, RuntimeLocations[index][RLOC_X], RuntimeLocations[index][RLOC_Y], RuntimeLocations[index][RLOC_Z]); }
