{
  "user": "your-github-user",
  "repo": "openrp-framework",
  "entry": "gamemodes\\gamemode.pwn",
  "output": "gamemodes\\gamemode.amx",
  "dependencies": [
    "sampctl/samp-stdlib",
    "Y-Less/samp-plugin-crashdetect:v4.22",
    "Y-Less/sscanf:v2.13.8",
    "Sreyas-Sreelal/samp-bcrypt:0.4.1",
    "oscar-broman/strlib",
    "samp-incognito/samp-streamer-plugin:v2.9.6",
    "Southclaws/zcmd",
    "oscar-broman/md-sort",
    "TommyB123/progress2:v2.3.0",
    "Coystark/MenuStore",
    "Southclaws/pawn-fsutil:1.3.0",
    "katursis/Pawn.Regex:1.2.3",
    "katursis/Pawn.RakNet:1.6.0",
    "pBlueG/SA-MP-MySQL:R41-4",
    "pawn-lang/YSI-Includes:v5.10.0006",
    "pawn-lang/amx_assembly:v1.0"
  ],
  "local": true,
  "runtime": {
    "version": "0.3.7",
    "mode": "server",
    "filterscripts": [],
    "plugins": [
      "ColAndreas"
    ],
    "rcon_password": "CHANGE_ME",
    "port": 7777,
    "hostname": "OpenRP Framework",
    "maxplayers": 50,
    "language": "",
    "mapname": "San Andreas",
    "weburl": "https://example.com",
    "gamemodetext": "OpenRP Framework",
    "announce": false,
    "lanmode": false,
    "query": true,
    "rcon": true,
    "logqueries": false,
    "sleep": 5,
    "maxnpc": 0,
    "stream_rate": 1000,
    "stream_distance": 300,
    "onfoot_rate": 30,
    "incar_rate": 30,
    "weapon_rate": 30,
    "chatlogging": true,
    "timestamp": true,
    "messageholelimit": 3000,
    "messageslimit": 750,
    "ackslimit": 8000,
    "playertimeout": 10000,
    "minconnectiontime": 0,
    "lagcompmode": 1,
    "connseedtime": 300000,
    "db_logging": false,
    "db_log_queries": false,
    "conncookies": true,
    "cookielogging": false,
    "output": true,
    "extra": {
      "crashdetect_log": "crashdetectinfo.txt",
      "long_call_time": "50000",
      "profiler_outputformat": "txt",
      "gamemode0": "gamemode"
    }
  },
  "builds": [
    {
      "name": "main",
      "args": [
        "-;+",
        "-(+",
        "-d3"
      ],
      "includes": [
        "legacy"
      ],
      "compiler": {
        "version": "3.10.10"
      }
    }
  ]
}
